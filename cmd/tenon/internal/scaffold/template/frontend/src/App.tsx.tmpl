import { useState, type FormEvent } from "react"
import { useMutation, useQuery, useQueryClient } from "@tanstack/react-query"
import { isApiError, type Todo } from "./api/api"
import { api } from "./client"

export function App() {
  const queryClient = useQueryClient()
  const todos = useQuery({ queryKey: ["todo"], queryFn: () => api.todo.list() })
  const refresh = () => queryClient.invalidateQueries({ queryKey: ["todo"] })

  const [title, setTitle] = useState("")
  const create = useMutation({
    mutationFn: () => api.todo.create({ title }),
    onSuccess: () => {
      setTitle("")
      return refresh()
    },
  })
  const toggle = useMutation({
    mutationFn: (t: Todo) => api.todo.update(t.id, { done: !t.done }),
    onSuccess: refresh,
  })
  const remove = useMutation({ mutationFn: (t: Todo) => api.todo.delete(t.id), onSuccess: refresh })

  function submit(e: FormEvent) {
    e.preventDefault()
    if (title.trim()) create.mutate()
  }

  const error = todos.error ?? create.error ?? toggle.error ?? remove.error
  return (
    <main>
      <h1>[[.Name]]</h1>
      <form onSubmit={submit}>
        <input value={title} onChange={(e) => setTitle(e.target.value)} placeholder="要做什么？" autoFocus />
        <button disabled={create.isPending}>添加</button>
      </form>
      {error && <p className="error">{isApiError(error) ? (error.detail ?? error.message) : String(error)}</p>}
      <ul>
        {(todos.data ?? []).map((t) => (
          <li key={t.id} className={t.done ? "done" : ""}>
            <label>
              <input type="checkbox" checked={t.done} onChange={() => toggle.mutate(t)} />
              {t.title}
            </label>
            <button onClick={() => remove.mutate(t)} aria-label="删除">×</button>
          </li>
        ))}
      </ul>
    </main>
  )
}
