package docs

import (
	"github.com/axadrn/shadcn-templ/v2/components/collapsible"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/sidebar"
	"github.com/go-tenon/tenon/web/ui"
)

// layout 是文档页的外壳：左侧是目录导航，顶栏是展开侧边栏的按钮、搜索框和 Actions，main 是正文区域。
templ layout(v view, main templ.Component) {
	@ui.Page(ui.PageProps{Title: v.documentTitle()}) {
		@sidebar.Provider(sidebar.ProviderProps{ID: SidebarID}) {
			@sidebar.Sidebar() {
				@sidebar.Header() {
					@sidebar.Menu() {
						@sidebar.MenuItem() {
							@sidebar.MenuButton(sidebar.MenuButtonProps{Size: sidebar.MenuButtonSizeLg, Href: v.home(), Attributes: templ.Attributes{"hx-boost": "true"}}) {
								if v.site.opts.Logo != nil {
									<div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-sidebar-primary text-sidebar-primary-foreground">
										@v.site.opts.Logo(icon.Props{Class: "size-4"})
									</div>
								}
								<span class="truncate font-semibold">{ v.site.opts.Title }</span>
							}
						}
					}
				}
				@sidebar.Content(sidebar.ContentProps{Attributes: boost}) {
					for _, g := range v.groups() {
						@navGroupView(v, g)
					}
				}
			}
			@sidebar.Inset(sidebar.InsetProps{Class: "min-w-0"}) {
				<header class="sticky top-0 z-10 flex h-14 shrink-0 items-center gap-2 border-b bg-background px-4">
					@sidebar.Trigger(sidebar.TriggerProps{Class: "-ml-1", Attributes: templ.Attributes{"aria-label": text(ctx, "ui.sidebar.toggle")}})
					<a href={ templ.SafeURL(v.home()) } class="truncate text-sm font-semibold md:hidden">{ v.site.opts.Title }</a>
					<div class="ml-auto flex flex-1 items-center justify-end gap-2">
						@searchBox(v)
						<a href={ templ.SafeURL(v.searchURL()) } class="inline-flex size-9 shrink-0 items-center justify-center rounded-md hover:bg-muted md:hidden" aria-label={ text(ctx, "docs.search") }>
							@icon.Search(icon.Props{Class: "size-4"})
						</a>
						if v.site.opts.Actions != nil {
							@v.site.opts.Actions
						}
						@ui.ThemeToggle()
					</div>
				</header>
				@main
			}
		}
	}
}

// navGroupView 是侧边栏中的一组。目录的首页有正文时，组的标题是它的链接。
templ navGroupView(v view, g navGroup) {
	@sidebar.Group() {
		if g.section != nil {
			@sidebar.GroupLabel() {
				if g.section.content {
					<a href={ templ.SafeURL(v.url(g.section)) } hx-boost="true" class="hover:text-sidebar-foreground data-active:text-sidebar-foreground" data-active?={ v.active(g.section) } data-docs-nav>{ g.section.title }</a>
				} else {
					{ g.section.title }
				}
			}
		}
		@sidebar.Menu() {
			for _, it := range g.items {
				if it.section == nil {
					@sidebar.MenuItem() {
						@sidebar.MenuButton(sidebar.MenuButtonProps{Href: v.url(it), IsActive: v.active(it), Attributes: navLink()}) {
							<span>{ it.title }</span>
						}
					}
				} else {
					@collapsible.Collapsible(collapsible.Props{DefaultOpen: v.open(it), Class: "group/collapsible"}) {
						@sidebar.MenuItem() {
							@sidebar.MenuButton(sidebar.MenuButtonProps{Attributes: collapsible.Trigger(ctx)}) {
								<span>{ it.title }</span>
								@icon.ChevronRight(icon.Props{Class: "ml-auto transition-transform duration-200 group-data-open/collapsible:rotate-90"})
							}
							@collapsible.Content() {
								@sidebar.MenuSub() {
									if it.content {
										@navSubItem(v, it, text(ctx, "docs.overview"))
									}
									for _, sub := range it.section.children {
										@navSubItem(v, sub, sub.title)
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

templ navSubItem(v view, p *page, label string) {
	@sidebar.MenuSubItem() {
		@sidebar.MenuSubButton(sidebar.MenuSubButtonProps{Href: v.url(p), IsActive: v.active(p), Attributes: navLink()}) {
			<span>{ label }</span>
		}
	}
}

// pageView 是正文区域：htmx 切换页面时替换的部分。
templ pageView(v view) {
	<div id={ PageID } class="flex flex-1 justify-center gap-10 px-4 py-8 md:px-8" data-docs-path={ v.url(v.page) } { boost... }>
		<article class="w-full min-w-0 max-w-3xl">
			if crumbs := v.crumbs(); len(crumbs) > 0 {
				<nav class="mb-3 flex flex-wrap items-center gap-1 text-sm text-muted-foreground" aria-label="breadcrumb">
					for i, c := range crumbs {
						if i > 0 {
							@icon.ChevronRight(icon.Props{Class: "size-3.5"})
						}
						<a href={ templ.SafeURL(v.url(c)) } hx-boost="true" class="hover:text-foreground">{ c.title }</a>
					}
				</nav>
			}
			<h1 class="text-3xl font-bold tracking-tight">{ v.title() }</h1>
			if v.page.description != "" {
				<p class="mt-2 text-lg text-muted-foreground">{ v.page.description }</p>
			}
			if v.page.content {
				<div class="docs-prose mt-8">
					@templ.Raw(localize(ctx, v.page.body))
				</div>
			}
			if list := v.listing(); len(list) > 0 {
				<div class="mt-8 grid gap-4 sm:grid-cols-2">
					for _, c := range list {
						<a href={ templ.SafeURL(v.url(c)) } hx-boost="true" class="rounded-lg border p-4 transition-colors hover:bg-muted">
							<p class="font-medium">{ c.title }</p>
							if c.description != "" {
								<p class="mt-1 text-sm text-muted-foreground">{ c.description }</p>
							}
						</a>
					}
				</div>
			}
			if v.page.prev != nil || v.page.next != nil {
				<nav class="mt-12 grid gap-4 border-t pt-6 sm:grid-cols-2">
					if p := v.page.prev; p != nil {
						<a href={ templ.SafeURL(v.url(p)) } hx-boost="true" rel="prev" class="flex flex-col gap-1 rounded-lg border p-4 transition-colors hover:bg-muted">
							<span class="text-sm text-muted-foreground">{ text(ctx, "docs.previous") }</span>
							<span class="font-medium">{ p.title }</span>
						</a>
					} else {
						<span class="hidden sm:block"></span>
					}
					if p := v.page.next; p != nil {
						<a href={ templ.SafeURL(v.url(p)) } hx-boost="true" rel="next" class="flex flex-col gap-1 rounded-lg border p-4 text-right transition-colors hover:bg-muted">
							<span class="text-sm text-muted-foreground">{ text(ctx, "docs.next") }</span>
							<span class="font-medium">{ p.title }</span>
						</a>
					}
				</nav>
			}
		</article>
		if len(v.page.toc) > 0 {
			<aside class="hidden w-56 shrink-0 xl:block">
				<nav class="sticky top-22 flex max-h-[calc(100svh-7rem)] flex-col gap-1 overflow-y-auto text-sm" data-docs-toc>
					<p class="mb-2 font-medium">{ text(ctx, "docs.toc") }</p>
					for _, h := range v.page.toc {
						<a href={ templ.SafeURL("#" + h.ID) } class={ "text-muted-foreground transition-colors hover:text-foreground data-active:font-medium data-active:text-foreground", templ.KV("pl-3", h.Level == 3) }>{ h.Text }</a>
					}
				</nav>
			</aside>
		}
	</div>
}

// searchBox 是顶栏中的搜索框：输入时用 htmx 取回结果，显示在下方的弹层中；回车打开搜索页。
templ searchBox(v view) {
	<form action={ templ.SafeURL(v.searchURL()) } method="get" role="search" class="relative hidden w-full max-w-xs md:block" x-data="{ open: false }" @click.outside="open = false" @keydown.escape="open = false">
		@input.Input(input.Props{Type: "search", Name: "q", Placeholder: text(ctx, "docs.search_placeholder"), Attributes: templ.Attributes{
			"aria-label":   text(ctx, "docs.search"),
			"autocomplete": "off",
			"hx-get":       v.searchURL(),
			"hx-trigger":   "input changed delay:200ms",
			"hx-target":    "#" + SearchResultsID,
			"hx-swap":      "innerHTML",
			"@focus":       "open = true",
			"@input":       "open = true",
		}})
		<div id={ SearchResultsID } x-show="open" class="absolute right-0 top-full z-50 mt-2 max-h-[70vh] w-[28rem] max-w-[calc(100vw-2rem)] overflow-y-auto rounded-lg border bg-popover p-1 text-popover-foreground shadow-md empty:hidden" @click="if ($event.target.closest('a')) open = false" { boost... }></div>
	</form>
}

// searchResults 是搜索结果的列表，搜索框的弹层和搜索页共用。
templ searchResults(v view, q string, results []result) {
	if len(results) == 0 && q != "" {
		<p class="px-3 py-6 text-center text-sm text-muted-foreground">{ text(ctx, "docs.no_results") }</p>
	}
	for _, r := range results {
		<a href={ templ.SafeURL(v.resultURL(r)) } hx-boost="true" class="block rounded-md px-3 py-2 hover:bg-muted focus-visible:bg-muted focus-visible:outline-none">
			<p class="text-sm font-medium">
				{ v.pageTitle(r.page) }
				if r.heading.ID != "" {
					<span class="text-muted-foreground">› { r.heading.Text }</span>
				}
			</p>
			if len(r.snippet) > 0 {
				<p class="mt-0.5 line-clamp-2 text-xs text-muted-foreground">
					for _, f := range r.snippet {
						if f.mark {
							<mark class="rounded-sm bg-primary/15 text-foreground">{ f.text }</mark>
						} else {
							{ f.text }
						}
					}
				</p>
			}
		</a>
	}
}

// searchView 是搜索页的正文区域：没有脚本时也能用，手机上从顶栏的搜索图标进入。
templ searchView(v view, q string, results []result) {
	<div id={ PageID } class="flex flex-1 justify-center px-4 py-8 md:px-8" data-docs-path={ v.searchURL() } { boost... }>
		<div class="w-full min-w-0 max-w-3xl">
			<h1 class="text-3xl font-bold tracking-tight">{ text(ctx, "docs.search") }</h1>
			<form action={ templ.SafeURL(v.searchURL()) } method="get" role="search" class="mt-6" hx-boost="true">
				@input.Input(input.Props{Type: "search", Name: "q", Value: q, Placeholder: text(ctx, "docs.search_placeholder"), Attributes: templ.Attributes{"aria-label": text(ctx, "docs.search")}})
			</form>
			<div class="mt-6 flex flex-col gap-1">
				@searchResults(v, q, results)
			</div>
		</div>
	</div>
}
