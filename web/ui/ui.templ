package ui

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/alertdialog"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/toast"
	"github.com/go-tenon/tenon/web"
)

// PageProps 配置 Page。
type PageProps struct {
	Title string
	// Lang 是 <html lang>，默认是请求的语言（i18n.Locale），没有时为 zh-CN。
	Lang string
	// Head 是追加在 <head> 末尾的内容，例如应用自己的脚本。
	Head templ.Component
	// BodyClass 是 <body> 的 class。
	BodyClass string
}

// Page 是一个完整的 HTML 文档：<html> 带当前主题的风格，<head> 由 Head 生成，children 是 <body> 的内容。
// 需要完全控制文档结构时不用 Page，自己写 <html class={ ui.Class(ctx) }> 并调用 Head。
templ Page(p PageProps) {
	<!DOCTYPE html>
	<html lang={ lang(ctx, p) } class={ Class(ctx) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Title }</title>
			@Head()
			if p.Head != nil {
				@p.Head
			}
		</head>
		<body class={ p.BodyClass }>
			{ children... }
		</body>
	</html>
}

// Toaster 用 shadcn-templ 的 toast 显示 htmx 请求带来的 web:flash，即局部请求的错误。
// 放在布局的 <body> 中，props 传给 toast.Toaster。
templ Toaster(props ...toast.ToasterProps) {
	@toast.Toaster(props...)
	<template data-web-ui-toaster></template>
}

// ConfirmID 是 Confirm 渲染的确认对话框的 ID。
const ConfirmID = "web-ui-confirm"

// Confirm 用确认对话框代替 hx-confirm 的浏览器原生确认框，放在布局的 <body> 中：
//
//	<button hx-post="/subscription/cancel" hx-confirm="退订邮件？" data-confirm-description="之后不再收到新文章的通知。"
//		data-confirm-action="退订" data-confirm-variant="destructive">退订</button>
//
// hx-confirm 是对话框的标题；元素上可选的 data-confirm-description 是说明，data-confirm-action 是确认按钮的文字，
// data-confirm-variant="destructive" 让确认按钮显示为危险操作。点击确认后才发出请求；取消、按 Esc 或点击遮罩时放弃。
// 页面中没有 Confirm 时，hx-confirm 仍然使用浏览器的确认框。
templ Confirm() {
	@alertdialog.AlertDialog(alertdialog.Props{ID: ConfirmID}) {
		@alertdialog.Content() {
			@alertdialog.Header() {
				@alertdialog.Title(alertdialog.TitleProps{Attributes: templ.Attributes{"data-web-ui-confirm-title": "true"}})
				@alertdialog.Description(alertdialog.DescriptionProps{Attributes: templ.Attributes{"data-web-ui-confirm-description": "true"}})
			}
			@alertdialog.Footer() {
				@alertdialog.Cancel() {
					{ text(ctx, "ui.confirm.cancel", "Cancel") }
				}
				@alertdialog.Action(alertdialog.ActionProps{Attributes: templ.Attributes{"data-web-ui-confirm-action": text(ctx, "ui.confirm.action", "Confirm")}}) {
					{ text(ctx, "ui.confirm.action", "Confirm") }
				}
			}
		}
	}
}

// ErrorPage 用当前主题渲染整页错误，可以直接作为 web.Options.ErrorPage。5xx 错误还显示 web.ErrorReference 的请求编号。
templ ErrorPage(status int, message string) {
	@Page(PageProps{Title: message}) {
		<main class="flex min-h-svh flex-col items-center justify-center gap-2 p-6 text-center">
			<p class="text-sm text-muted-foreground">{ strconv.Itoa(status) }</p>
			<h1 class="text-2xl font-semibold">{ message }</h1>
			if ref := web.ErrorReference(ctx); status >= 500 && ref != "" {
				<p class="text-xs text-muted-foreground">{ ref }</p>
			}
		</main>
	}
}

func orDefault(s, fallback string) string {
	if s == "" {
		return fallback
	}
	return s
}

// ThemeToggle 是切换暗色模式的按钮，选择记在浏览器中。放在页面的任何位置。
templ ThemeToggle() {
	@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"data-web-ui-theme-toggle": "true", "aria-label": text(ctx, "ui.theme.toggle", "Toggle dark mode")}}) {
		@icon.Moon(icon.Props{Class: "dark:hidden"})
		@icon.Sun(icon.Props{Class: "hidden dark:block"})
	}
}
