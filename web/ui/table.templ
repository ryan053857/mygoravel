package ui

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/empty"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/table"
)

// SortHead 是可以点击排序的表头：点击按 key 升序，再点击改为降序；当前排序的列显示方向箭头并带 aria-sort。
// current 是当前的排序参数（key 为升序，-key 为降序），url 返回按某个排序参数排列的地址，通常由 web.QueryURL 生成，
// 并回到第一页。
//
//	@ui.SortHead(q.Sort, "title", "标题", q.SortURL, ui.SortHeadProps{HTMX: true})
templ SortHead(current, key, label string, url func(sort string) string, props ...SortHeadProps) {
	{{ p := firstSortProps(props) }}
	{{ href := url(nextSort(current, key, p.DescFirst)) }}
	{{ dir := sortDirection(current, key) }}
	@table.Head(table.HeadProps{Class: p.Class, Attributes: sortHeadAttrs(current, key)}) {
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Href: href, Class: "-ml-2.5 data-[sorted]:text-foreground", Attributes: merge(sortLinkAttrs(href, p.HTMX), sortedAttr(dir))}) {
			{ label }
			switch dir {
				case "ascending":
					@icon.ArrowUp(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-end"}})
				case "descending":
					@icon.ArrowDown(icon.Props{Attributes: templ.Attributes{"data-icon": "inline-end"}})
				default:
					@icon.ChevronsUpDown(icon.Props{Class: "text-muted-foreground", Attributes: templ.Attributes{"data-icon": "inline-end"}})
			}
		}
	}
}

// Empty 是列表没有数据时的提示：图标、标题、说明，children 是操作，例如「新建文章」按钮。
//
//	@ui.Empty(ui.EmptyProps{Icon: icon.FileText, Title: "还没有文章", Description: "写下第一篇文章吧。"}) {
//		@button.Button(button.Props{Href: "/admin/articles/new"}) { 新建文章 }
//	}
templ Empty(p EmptyProps) {
	@empty.Empty(empty.Props{Class: "border border-dashed " + p.Class}) {
		@empty.Header() {
			if p.Icon != nil {
				@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
					@p.Icon()
				}
			}
			if p.Title != "" {
				@empty.Title() {
					{ p.Title }
				}
			}
			if p.Description != "" {
				@empty.Description() {
					{ p.Description }
				}
			}
		}
		@empty.Content() {
			{ children... }
		}
	}
}
