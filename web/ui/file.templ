package ui

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
)

// FileField 是上传文件的字段：用户选择文件后立即上传到 p.Upload（upload.Handler），显示进度、文件名、大小，
// 图片显示缩略图，可以移除。表单提交的是文件 ID（同名的隐藏字段），业务保存时用 filesystem.Service.Confirm 确认。
// 上传期间表单不能提交；超过 MaxSize 的文件在浏览器中直接提示。
//
//	@ui.FileField(f, "cover_id", "封面", ui.FileFieldProps{Upload: "/uploads", Accept: "image/*", MaxSize: 5 << 20})
//
// 字段在 htmx 替换中保留（hx-preserve）：验证失败重新渲染表单时，已上传的文件仍然显示。
templ FileField(f Form, name, label string, p FileFieldProps) {
	{{ id := orDefault(p.ID, name) }}
	{{ msg := f.Error(name) }}
	@field.Field(field.Props{Class: p.Class, Attributes: invalid("data-invalid", msg)}) {
		@field.Label(field.LabelProps{For: id + "-input"}) {
			{ label }
		}
		<div
			id={ id }
			class="flex flex-col gap-2"
			hx-preserve="true"
			data-web-ui-file={ p.Upload }
			data-name={ name }
			if p.Multiple {
				data-multiple="true"
			}
			if p.MaxSize > 0 {
				data-max-size={ strconv.FormatInt(p.MaxSize, 10) }
				data-msg-too-large={ text(ctx, "ui.file.too_large", "The file must not be larger than") + " " + humanSize(p.MaxSize) }
			}
			data-msg-failed={ text(ctx, "ui.file.failed", "Upload failed") }
		>
			<ul class="flex flex-col gap-2 empty:hidden" data-web-ui-file-list>
				for _, fi := range fileItems(f, name, p.Files) {
					@fileItem(name, fi)
				}
			</ul>
			<template data-web-ui-file-template>
				@fileItem(name, FileInfo{})
			</template>
			@input.Input(input.Props{ID: id + "-input", Type: "file", Attributes: merge(merge(invalid("aria-invalid", msg), templ.Attributes{"accept": p.Accept}), multipleAttr(p.Multiple))})
		</div>
		if msg != "" {
			@field.Error(field.ErrorProps{Attributes: templ.Attributes{"data-web-ui-file-error": "true"}}) {
				{ msg }
			}
		} else {
			@field.Error(field.ErrorProps{Attributes: templ.Attributes{"data-web-ui-file-error": "true", "hidden": true}})
			if p.Description != "" {
				@field.Description() {
					{ p.Description }
				}
			}
		}
	}
}

templ fileItem(name string, fi FileInfo) {
	<li class="flex items-center gap-3 rounded-lg border p-2 text-sm" data-web-ui-file-item>
		<input type="hidden" name={ name } value={ fi.ID }/>
		<img class="size-10 shrink-0 rounded-md object-cover" alt="" data-preview if isImage(fi) {
			src={ fi.URL }
		} else {
			hidden
		}/>
		<div class="flex min-w-0 flex-1 flex-col gap-1">
			<span class="truncate font-medium" data-filename>
				if fi.URL != "" {
					<a href={ templ.SafeURL(fi.URL) } target="_blank" rel="noopener" class="hover:underline">{ fi.Filename }</a>
				} else {
					{ fi.Filename }
				}
			</span>
			<span class="text-xs text-muted-foreground" data-size>{ humanSize(fi.Size) }</span>
			<div class="h-1 w-full overflow-hidden rounded-full bg-muted" data-progress hidden>
				<div class="h-full w-0 bg-primary transition-[width]" data-progress-bar></div>
			</div>
		</div>
		@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIconSm, Attributes: templ.Attributes{"data-web-ui-file-remove": "true", "aria-label": text(ctx, "ui.file.remove", "Remove")}}) {
			@icon.X()
		}
	</li>
}
