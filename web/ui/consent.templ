package ui

import (
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"sort"
)

// ConsentProps 配置 ConsentPage。
type ConsentProps struct {
	// Brand 是卡片上方的名称，通常是应用名。
	Brand string
	// ClientName 是请求授权的应用，例如 Claude。
	ClientName string
	// RedirectHost 是授权后跳转到的主机名，例如 claude.ai，让用户确认去向。
	RedirectHost string
	// Account 是当前登录的账号，例如邮箱，让用户确认授权的是哪个账号。
	Account string
	// Scopes 是申请的范围。
	Scopes []ConsentScope
	// Action 是表单提交的地址，Fields 是要原样提交回去的授权参数。
	Action string
	Fields map[string]string
	// SwitchAccount 是切换账号的地址，例如退出登录再回到这里；为空时不显示。
	SwitchAccount string
}

// ConsentScope 是同意页上的一个范围。
type ConsentScope struct {
	Name        string
	Description string
}

// ConsentPage 是 OAuth 授权的同意页：哪个应用、以哪个账号、申请哪些范围、授权后跳转到哪里，以及允许和拒绝两个按钮。
// 提交的 decision 字段是 allow 或 deny。oauthserver 默认使用它。
templ ConsentPage(p ConsentProps) {
	@Page(PageProps{Title: p.ClientName}) {
		@AuthCard(AuthCardProps{Brand: p.Brand, Title: p.ClientName, Description: text(ctx, "ui.consent.description", "requests access to your account")}) {
			<form method="post" action={ templ.SafeURL(p.Action) } class="flex flex-col gap-6">
				for _, name := range sortedKeys(p.Fields) {
					<input type="hidden" name={ name } value={ p.Fields[name] }/>
				}
				if p.Account != "" {
					<div class="flex flex-col gap-2 text-sm">
						<span class="text-muted-foreground">{ text(ctx, "ui.consent.account", "Signed in as") }</span>
						<span class="font-medium">{ p.Account }</span>
						if p.SwitchAccount != "" {
							<a href={ templ.SafeURL(p.SwitchAccount) } class="text-muted-foreground">{ text(ctx, "ui.consent.switch", "Use another account") }</a>
						}
					</div>
				}
				<div class="flex flex-col gap-2 text-sm">
					<span class="text-muted-foreground">{ text(ctx, "ui.consent.scopes", "It will be able to") }</span>
					for _, s := range p.Scopes {
						<div class="flex flex-col">
							<span class="font-medium">{ orDefault(s.Description, s.Name) }</span>
							if s.Description != "" {
								<span class="text-xs text-muted-foreground font-mono">{ s.Name }</span>
							}
						</div>
					}
				</div>
				if p.RedirectHost != "" {
					<p class="text-xs text-muted-foreground">
						{ text(ctx, "ui.consent.redirect", "You will be redirected to") } <span class="font-medium">{ p.RedirectHost }</span>
					</p>
				}
				<div class="flex gap-2 justify-end">
					@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeSubmit, Attributes: templ.Attributes{"name": "decision", "value": "deny"}}) {
						{ text(ctx, "ui.consent.deny", "Deny") }
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Attributes: templ.Attributes{"name": "decision", "value": "allow"}}) {
						{ text(ctx, "ui.consent.allow", "Allow") }
					}
				</div>
			</form>
		}
	}
}

func sortedKeys(m map[string]string) []string {
	keys := make([]string, 0, len(m))
	for k := range m {
		keys = append(keys, k)
	}
	sort.Strings(keys)
	return keys
}
