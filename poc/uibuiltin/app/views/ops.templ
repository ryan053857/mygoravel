package views

import (
	"strconv"

	"github.com/axadrn/shadcn-templ/v2/components/alertdialog"
	"github.com/axadrn/shadcn-templ/v2/components/badge"
	"github.com/axadrn/shadcn-templ/v2/components/button"
	"github.com/axadrn/shadcn-templ/v2/components/card"
	"github.com/axadrn/shadcn-templ/v2/components/dialog"
	"github.com/axadrn/shadcn-templ/v2/components/field"
	"github.com/axadrn/shadcn-templ/v2/components/icon"
	"github.com/axadrn/shadcn-templ/v2/components/input"
	"github.com/axadrn/shadcn-templ/v2/components/nativeselect"
	"github.com/axadrn/shadcn-templ/v2/components/table"
	"github.com/ryan053857/mygoravel/page"
	"github.com/ryan053857/mygoravel/poc/uibuiltin/app/article"
	"github.com/ryan053857/mygoravel/poc/uibuiltin/webui"
	"github.com/ryan053857/mygoravel/web"
)

// 运营后台：只用框架内置的样式表（不装 Tailwind），组件直接 import shadcn-templ。

templ opsLayout(title string) {
	@webui.Page(webui.PageProps{Title: title + " · 运营后台"}) {
		<header class="flex items-center justify-between border-b px-6 py-3">
			<a href="/ops/articles" class="font-semibold">运营后台</a>
			<div class="flex items-center gap-2">
				@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeIcon, Attributes: templ.Attributes{"data-webui-theme-toggle": "true", "aria-label": "切换暗色模式", "id": "theme-toggle"}}) {
					@icon.Moon()
				}
				<form method="post" action="/ops/logout">
					@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Type: button.TypeSubmit}) {
						退出
					}
				</form>
			</div>
		</header>
		<main class="mx-auto flex max-w-5xl flex-col gap-6 p-6">
			{ children... }
		</main>
		@webui.Modal()
		@webui.Toaster()
	}
}

type LoginForm struct {
	Email    string `json:"email" format:"email"`
	Password string `json:"password" minLength:"1"`
}

templ OpsLogin(f *web.Form[LoginForm]) {
	@webui.Page(webui.PageProps{Title: "运营后台登录"}) {
		<main class="flex min-h-svh items-center justify-center p-6">
			@card.Card(card.Props{Class: "w-full max-w-sm"}) {
				@card.Header() {
					@card.Title() {
						运营后台
					}
					@card.Description() {
						使用运营账号登录
					}
				}
				@card.Content() {
					<form id="login" method="post" class="flex flex-col gap-4">
						@webui.TextField(f, "email", "邮箱", webui.FieldProps{Type: "email", Placeholder: "ops@example.com"})
						@webui.TextField(f, "password", "密码", webui.FieldProps{Type: "password"})
						@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
							登录
						}
					</form>
				}
			}
		</main>
		@webui.Toaster()
	}
}

type ListQuery struct {
	Q      string `json:"q,omitempty"`
	Status string `json:"status,omitempty" enum:"draft,published,archived"`
	page.OffsetParams
}

func (q ListQuery) URL() string { return web.QueryURL("/ops/articles", q) }

func (q ListQuery) PageURL(n int) string {
	q.Page = n
	return q.URL()
}

templ OpsArticles(q ListQuery, list page.Offset[article.Article]) {
	@opsLayout("文章") {
		<div class="flex items-center justify-between">
			<h1 class="text-xl font-semibold">文章</h1>
			@button.Button(button.Props{ID: "new-article", Attributes: templ.Attributes{"hx-get": "/ops/articles/new", "hx-target": webui.ModalTarget}}) {
				@icon.Plus()
				新建文章
			}
		</div>
		@OpsArticleTable(q, list)
	}
}

templ OpsArticleTable(q ListQuery, list page.Offset[article.Article]) {
	<section id="articles" class="flex flex-col gap-4" hx-target:inherited="this" hx-swap:inherited="outerHTML" hx-get={ q.URL() } hx-trigger="articles:changed from:body">
		<form class="flex gap-2" hx-get="/ops/articles" hx-trigger="input delay:300ms from:#q, change from:#status">
			@input.Input(input.Props{ID: "q", Name: "q", Type: "search", Placeholder: "搜索标题或 slug", Value: q.Q, Class: "max-w-xs", Attributes: templ.Attributes{"hx-preserve": "true"}})
			@nativeselect.NativeSelect(nativeselect.Props{ID: "status", Name: "status"}) {
				@nativeselect.Option(nativeselect.OptionProps{Value: "", Selected: q.Status == ""}) {
					全部状态
				}
				for _, s := range []string{"draft", "published", "archived"} {
					@nativeselect.Option(nativeselect.OptionProps{Value: s, Selected: q.Status == s}) {
						{ statusText(s) }
					}
				}
			}
		</form>
		<p id="total" class="text-muted-foreground text-sm">共 { strconv.Itoa(list.Total) } 篇</p>
		@table.Table() {
			@table.Header() {
				@table.Row() {
					@table.Head() {
						标题
					}
					@table.Head() {
						Slug
					}
					@table.Head() {
						状态
					}
					@table.Head(table.HeadProps{Class: "text-right"}) {
						操作
					}
				}
			}
			@table.Body() {
				for _, a := range list.Items {
					@table.Row() {
						@table.Cell() {
							{ a.Title }
						}
						@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
							{ a.Slug }
						}
						@table.Cell() {
							@badge.Badge(badge.Props{Variant: statusVariant(a.Status)}) {
								{ statusText(a.Status) }
							}
						}
						@table.Cell(table.CellProps{Class: "text-right"}) {
							@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Attributes: templ.Attributes{"hx-get": "/ops/articles/" + strconv.Itoa(a.ID) + "/delete", "hx-target": webui.ModalTarget, "data-delete": strconv.Itoa(a.ID)}}) {
								删除
							}
						}
					}
				}
			}
		}
		@webui.Pagination(list, list.Page, webui.PaginationProps{URL: q.PageURL, HTMX: true})
	</section>
}

templ OpsNewDialog(f *web.Form[article.Changes]) {
	@dialog.Dialog(dialog.Props{ID: "article-dialog", DefaultOpen: true}) {
		@dialog.Content() {
			@dialog.Header() {
				@dialog.Title() {
					新建文章
				}
				@dialog.Description() {
					保存后出现在列表顶部。
				}
			}
			@OpsArticleForm(f)
		}
	}
}

templ OpsArticleForm(f *web.Form[article.Changes]) {
	<form id="article-form" class="flex flex-col gap-4" hx-post="/ops/articles" hx-swap="outerMorph">
		@webui.TextField(f, "title", "标题")
		@webui.TextField(f, "slug", "Slug", webui.FieldProps{Description: "小写字母、数字和连字符"})
		@field.Field() {
			@field.Label(field.LabelProps{For: "status-input"}) {
				状态
			}
			@nativeselect.NativeSelect(nativeselect.Props{ID: "status-input", Name: "status"}) {
				for _, s := range []string{"draft", "published", "archived"} {
					@nativeselect.Option(nativeselect.OptionProps{Value: s, Selected: f.Value("status") == s}) {
						{ statusText(s) }
					}
				}
			}
		}
		@dialog.Footer() {
			@button.Button(button.Props{Type: button.TypeSubmit}) {
				保存
			}
		}
	</form>
}

templ OpsDeleteDialog(a article.Article) {
	@alertdialog.AlertDialog(alertdialog.Props{ID: "delete-dialog", DefaultOpen: true}) {
		@alertdialog.Content() {
			@alertdialog.Header() {
				@alertdialog.Title() {
					删除「{ a.Title }」？
				}
				@alertdialog.Description() {
					删除后无法恢复。
				}
			}
			@alertdialog.Footer() {
				@alertdialog.Cancel() {
					取消
				}
				@alertdialog.Action(alertdialog.ActionProps{Variant: button.VariantDestructive, Attributes: templ.Attributes{"hx-delete": "/ops/articles/" + strconv.Itoa(a.ID), "id": "confirm-delete"}}) {
					删除
				}
			}
		}
	}
}

func statusText(s string) string {
	return map[string]string{"draft": "草稿", "published": "已发布", "archived": "已归档"}[s]
}

func statusVariant(s string) badge.Variant {
	switch s {
	case "published":
		return badge.VariantDefault
	case "draft":
		return badge.VariantSecondary
	}
	return badge.VariantOutline
}
